/* Glass 全局样式（GlassMusicPlayer 风格 · 第一阶段）
 * Token 来源见 tokens.py；尺寸语义（padding/min-height）与 dark.qss 对齐，
 * 避免影响面板几何断言。QMainWindow 背景透明——由 MainWindow.paintEvent 绘制
 * 深色半透明圆角底色。
 */

/* 全局 */
QWidget {
    background-color: #1e1e2e;
    color: #e0e0e8;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}
/* 主窗口透明（paintEvent 手绘玻璃底）；QDialog 深色半透明卡片 */
QMainWindow { background: transparent; }
QDialog {
    background-color: rgba(42, 42, 62, 235);
    border: 1px solid rgba(74, 158, 255, 0.25);
    border-radius: 12px;
}
QLabel { background: transparent; color: #e0e0e8; }
QLabel[class="secondary"] { color: #9090a8; font-size: 12px; }
QLabel[class="title"] { color: #e0e0e8; font-size: 15px; font-weight: bold; }
QLabel[class="status-success"] { color: #4ade80; }
QLabel[class="status-error"] { color: #ef4444; }
QLabel[class="status-warning"] { color: #f59e0b; }

/* 按钮：全局圆角半透明 */
QPushButton {
    background-color: rgba(42, 42, 62, 200);
    color: #e0e0e8;
    border: 1px solid rgba(74, 158, 255, 0.35);
    border-radius: 12px;
    padding: 8px 16px;
    min-height: 20px;
    font-weight: 500;
}
QPushButton:hover { background-color: rgba(51, 51, 74, 210); border-color: #4a9eff; }
QPushButton:pressed { background-color: rgba(62, 62, 92, 220); }
QPushButton:disabled { color: #5a5a72; background-color: rgba(34, 34, 46, 190); border-color: rgba(42, 42, 62, 200); }
QPushButton[class="primary"] { background-color: #4a9eff; border-color: #4a9eff; color: #ffffff; }
QPushButton[class="primary"]:hover { background-color: #5eaaff; border-color: #5eaaff; }
QPushButton[class="primary"]:pressed { background-color: #3a8eef; border-color: #3a8eef; }

/* ToggleButton */
QPushButton[toggle="on"] { background-color: rgba(42, 74, 46, 210); border: 1px solid #4ade80; color: #4ade80; }
QPushButton[toggle="on"]:hover { background-color: rgba(52, 90, 58, 220); }
QPushButton[toggle="off"] { background-color: rgba(42, 42, 62, 200); border: 1px solid rgba(58, 58, 78, 200); color: #9090a8; }
QPushButton[toggle="off"]:hover { background-color: rgba(51, 51, 74, 210); border-color: #4a4a62; }

/* 输入 */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(42, 42, 62, 200);
    color: #e0e0e8;
    border: 1px solid rgba(58, 58, 78, 210);
    border-radius: 12px;
    padding: 6px 10px;
    selection-background-color: #4a9eff; selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus { border-color: #4a9eff; }
QLineEdit::placeholder { color: #5a5a72; }

/* 下拉 */
QComboBox {
    background-color: rgba(42, 42, 62, 200);
    color: #e0e0e8;
    border: 1px solid rgba(58, 58, 78, 210);
    border-radius: 12px;
    padding: 6px 10px; min-height: 20px;
}
QComboBox:hover { border-color: #4a9eff; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: none; border-left: 4px solid transparent;
    border-right: 4px solid transparent; border-top: 5px solid #9090a8;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: rgba(42, 42, 62, 240); color: #e0e0e8;
    border: 1px solid rgba(58, 58, 78, 210); border-radius: 8px;
    selection-background-color: #4a9eff; selection-color: #ffffff; outline: none;
}

/* Tab：半透明面板 + 导航胶囊高亮 */
QTabWidget::pane {
    border: 1px solid rgba(74, 158, 255, 0.22);
    border-radius: 12px;
    background-color: rgba(42, 42, 62, 230);
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #9090a8;
    padding: 9px 20px;
    border: none;
    border-radius: 12px;
    font-weight: 500;
    margin: 2px 3px;
}
QTabBar::tab:hover { color: #e0e0e8; background-color: rgba(51, 51, 74, 180); }
/* 选中态：半透明高亮胶囊（GlassMusicPlayer 风格） */
QTabBar::tab:selected {
    color: #e0e0e8;
    background-color: rgba(74, 158, 255, 0.26);
    border: 1px solid rgba(74, 158, 255, 0.55);
}

/* 列表 */
QListWidget, QListView {
    background-color: rgba(30, 30, 46, 210);
    color: #e0e0e8;
    border: 1px solid rgba(58, 58, 78, 210);
    border-radius: 12px;
    outline: none; padding: 4px;
}
QListWidget::item { padding: 8px 10px; border-radius: 8px; margin: 2px 0; }
QListWidget::item:hover { background-color: rgba(42, 42, 62, 200); }
QListWidget::item:selected { background-color: rgba(74, 158, 255, 0.3); color: #e0e0e8; }

/* 滚动条：极简细线半透明 */
QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(90, 90, 114, 150); border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: rgba(74, 158, 255, 150); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 6px; }
QScrollBar::handle:horizontal { background: rgba(90, 90, 114, 150); border-radius: 3px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: rgba(74, 158, 255, 150); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Checkbox */
QCheckBox { color: #e0e0e8; spacing: 8px; }
QCheckBox::indicator {
    width: 18px; height: 18px; border-radius: 6px;
    border: 1px solid rgba(58, 58, 78, 210); background-color: rgba(42, 42, 62, 200);
}
QCheckBox::indicator:hover { border-color: #4a9eff; }
QCheckBox::indicator:checked {
    background-color: #4a9eff; border-color: #4a9eff; image: none;
}

/* Slider */
QSlider::groove:horizontal { height: 4px; background: rgba(58, 58, 78, 210); border-radius: 2px; }
QSlider::sub-page:horizontal { background: #4a9eff; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #e0e0e8; border: none; width: 14px; height: 14px;
    margin: -5px 0; border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: #4a9eff; }

/* GroupBox */
QGroupBox {
    background-color: rgba(42, 42, 62, 210);
    border: 1px solid rgba(58, 58, 78, 210);
    border-radius: 12px; margin-top: 12px; padding-top: 12px; font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #9090a8;
}

/* Tooltip */
QToolTip {
    background-color: rgba(42, 42, 62, 245); color: #e0e0e8;
    border: 1px solid rgba(74, 158, 255, 0.6); border-radius: 8px; padding: 6px 10px;
}

/* Menu */
QMenu {
    background-color: rgba(42, 42, 62, 245); color: #e0e0e8;
    border: 1px solid rgba(58, 58, 78, 210); border-radius: 12px; padding: 6px;
}
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 8px; }
QMenu::item:selected { background-color: rgba(74, 158, 255, 0.3); color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(58, 58, 78, 210); margin: 4px 8px; }

/* ---- Glass 专属（主窗口外壳） ---- */
/* 无边框主窗口内层容器：透出 MainWindow.paintEvent 玻璃底 */
#GlassShellRoot { background: transparent; }
/* 自定义顶栏：半透明 + 圆角上沿跟随窗口 */
#GlassTitleBar {
    background: transparent;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}
#GlassTitleBar QLabel { color: #9090a8; font-size: 12px; }
/* 顶栏窗口控制按钮：小号圆角 */
#GlassTitleBar QPushButton {
    background: transparent; border: none; border-radius: 8px;
    padding: 4px 10px; min-height: 0; font-size: 13px; color: #9090a8;
}
#GlassTitleBar QPushButton:hover { background-color: rgba(51, 51, 74, 200); color: #e0e0e8; }
#GlassTitleBar QPushButton#btn_close:hover { background-color: #ef4444; color: #ffffff; }
